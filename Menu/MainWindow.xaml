<Window x:Class="RonMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RonMenu"
        Title="RON Cheat Menu By ASwave" Width="840" Height="540" MinWidth="680" MinHeight="440" ResizeMode="CanResize" FontFamily="宋体"
        WindowStartupLocation="CenterOwner" Topmost="False" ShowActivated="False" ShowInTaskbar="False" Cursor="None" ForceCursor="True" Background="{DynamicResource BgBrush}"
        WindowStyle="None" AllowsTransparency="True">
  <Border x:Name="RootFrame" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Canvas x:Name="FxCanvas" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
        <!-- The glows are plain radial gradients that fade to fully transparent -
             no BlurEffect. The menu is a layered window, so every frame is
             composited in software and a blur over a 330 px ellipse was the most
             expensive thing on screen (it is what made the game hitch). -->
        <Ellipse x:Name="GlowOrb" Width="330" Height="330" Canvas.Left="-150" Canvas.Top="24" Opacity="0.34" Fill="{DynamicResource GlowBrush}">
          <Ellipse.RenderTransform><TranslateTransform x:Name="GlowOrbShift" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="GlowOrb2" Width="280" Height="280" Canvas.Left="500" Canvas.Top="250" Opacity="0.26" Fill="{DynamicResource GlowAltBrush}">
          <Ellipse.RenderTransform><TranslateTransform x:Name="GlowOrb2Shift" /></Ellipse.RenderTransform>
        </Ellipse>
        <Border x:Name="ScanLine" Height="1" Width="840" Canvas.Left="0" Canvas.Top="0" Opacity="0.32" Background="{DynamicResource ScanBrush}">
          <Border.RenderTransform><TranslateTransform x:Name="ScanShift" /></Border.RenderTransform>
        </Border>
      </Canvas>

      <!-- The menu cursor is drawn by CursorOverlay (a separate full-screen,
           click-through window). A glyph inside this window would be clipped at
           the panel edge, which made the pointer appear to stick there. -->

      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="14,0,0,14" Padding="18">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="3,5,0,30">
              <Border Width="34" Height="34" Background="{DynamicResource ActiveBrush}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"><TextBlock Text="R" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="RON CHEAT MENU" FontWeight="Bold" FontSize="12.5"/>
                <TextBlock Text="{x:Static local:AppVersion.Display}" Foreground="{DynamicResource MetaBrush}" FontSize="10" Margin="0,3,0,0"/>
                <TextBlock x:Name="BrandSubtitle" Text="BY ASWAVE" Foreground="{DynamicResource MetaBrush}" FontSize="9" Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="MenuLabel" Text="菜单" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="12,0,0,8"/>
            <Button x:Name="VisualsNav" Style="{StaticResource NavButton}" Content="◈   视觉" Click="Nav_Click" Tag="Active"/>
            <Button x:Name="PlayerNav" Style="{StaticResource NavButton}" Content="♙   玩家" Click="Nav_Click"/>
            <Button x:Name="WeaponNav" Style="{StaticResource NavButton}" Content="⌁   武器" Click="Nav_Click"/>
            <Button x:Name="WorldNav" Style="{StaticResource NavButton}" Content="◎   世界" Click="Nav_Click"/>
            <Button x:Name="AimNav" Style="{StaticResource NavButton}" Content="⊙   瞄准" Click="Nav_Click"/>
            <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙   设置" Click="Nav_Click"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="6,0,6,4">
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#E7A44A" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionText" Text="等待游戏连接" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0"/></StackPanel>
            <TextBlock Text="BY ASWAVE  ·  READY OR NOT" Foreground="{DynamicResource SubtleBrush}" FontSize="9" Margin="15,8,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Margin="0,18,0,18" Background="{DynamicResource LineBrush}" Opacity="0.75" IsHitTestVisible="False"/>
      <Grid Grid.Column="1" Margin="30,25,30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,2,0,18">
          <StackPanel><TextBlock x:Name="PageTitle" Text="视觉" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="配置玩家与场景显示" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <TextBlock x:Name="HeaderMeta" Text="BY ASWAVE  ·  菜单" Foreground="{DynamicResource MetaBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,18,0"/>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PageHost"/>
        </ScrollViewer>
        <TextBlock x:Name="FooterHint" Grid.Row="2" Text="设置将通过游戏内接口生效" Foreground="{DynamicResource MetaBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,10,2,0"/>
      </Grid>

      <!-- Decorative HUD frame, drawn last so it sits above the sidebar and the
           content. All of it is static geometry: one 1 px accent frame, four
           corner brackets and a divider. It costs one repaint per theme change
           instead of one per animation frame, and the only animated part is the
           frame opacity (a single 30 fps timeline). -->
      <Border x:Name="PulseFrame" Grid.ColumnSpan="2" Margin="5" CornerRadius="10" BorderThickness="1"
              BorderBrush="{DynamicResource AccentBrush}" Opacity="0.16" IsHitTestVisible="False" />
      <Border Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Width="18" Height="18"
              BorderThickness="1.4,1.4,0,0" BorderBrush="{DynamicResource AccentBrush}" CornerRadius="7,0,0,0" Opacity="0.55" IsHitTestVisible="False" />
      <Border Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Width="18" Height="18"
              BorderThickness="0,1.4,1.4,0" BorderBrush="{DynamicResource AccentBrush}" CornerRadius="0,7,0,0" Opacity="0.55" IsHitTestVisible="False" />
      <Border Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Width="18" Height="18"
              BorderThickness="1.4,0,0,1.4" BorderBrush="{DynamicResource AccentBrush}" CornerRadius="0,0,0,7" Opacity="0.55" IsHitTestVisible="False" />
      <Border Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Width="18" Height="18"
              BorderThickness="0,0,1.4,1.4" BorderBrush="{DynamicResource AccentBrush}" CornerRadius="0,0,7,0" Opacity="0.55" IsHitTestVisible="False" />
    </Grid>
  </Border>
</Window>
